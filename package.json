{
  "name": "ink-markdown-es-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --filter '*' build",
    "check": "bun run --filter '*' check",
    "dev": "bun run --filter ink-shiki-code build && cd packages/ink-markdown-es && bun run dev",
    "format": "bun run --filter '*' format"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.8"
  }
}
